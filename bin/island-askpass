#!/usr/bin/env python3
"""Password helper for SUDO_ASKPASS. Stdout belongs exclusively to sudo."""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from askpass import helper
raise SystemExit(helper(sys.argv[1] if len(sys.argv) > 1 else 'Password'))
